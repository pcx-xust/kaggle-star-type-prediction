# ==============================

# Python cache files

# ==============================

**pycache**/
*.py[cod]
*$py.class
*.so

# ==============================

# Virtual environments

# ==============================

.venv/
venv/
env/
ENV/

# ==============================

# Jupyter Notebook

# ==============================

.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ==============================

# VS Code / IDE temporary files

# ==============================

.vscode/*
!.vscode/settings.json
tempCodeRunnerFile.py

# ==============================

# System files

# ==============================

.DS_Store
Thumbs.db

# ==============================

# Kaggle API key

# Never upload this file

# ==============================

kaggle.json
**/kaggle.json

# ==============================

# Raw and processed data

# Keep folder structure with .gitkeep only

# ==============================

data/raw/**
!data/raw/.gitkeep

data/processed/**
!data/processed/.gitkeep

# ==============================

# Submission files

# Kaggle submission CSV files should not be uploaded

# ==============================

submissions/**
!submissions/.gitkeep

data/submissions/**
!data/submissions/.gitkeep

# ==============================

# Trained model files

# Model binaries should not be uploaded

# ==============================

models/**
!models/.gitkeep

*.pkl
*.joblib
*.model
*.txt.model
*.bin

# ==============================

# Logs and temporary outputs

# ==============================

logs/
*.log

# ==============================

# Local environment files

# ==============================

.env
.env.*
